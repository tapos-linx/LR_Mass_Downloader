rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Validation Helpers ---

    function isValidUser(data) {
      return data.userId == request.auth.uid &&
             data.email is string && data.email.size() <= 100 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.lastSignInAt is timestamp && data.lastSignInAt <= request.time;
    }

    function isValidSavedRecord(data) {
      return data.userId == request.auth.uid &&
             data.mouzaId is string && data.mouzaId.size() <= 128 &&
             data.mouzaNameEn is string && data.mouzaNameEn.size() <= 200 &&
             data.downloadedAt is timestamp && data.downloadedAt <= request.time &&
             (!('khatianCount' in data) || data.khatianCount is int) &&
             (!('recordType' in data) || (data.recordType is string && data.recordType.size() <= 50)) &&
             (!('downloadFormat' in data) || (data.downloadFormat in ['PDF', 'IMAGE']));
    }

    function isValidDownloadTask(data) {
      return data.userId == request.auth.uid &&
             data.mouzaId is string && data.mouzaId.size() <= 128 &&
             data.status in ['PENDING', 'DOWNLOADING', 'COMPLETED', 'FAILED'] &&
             data.timestamp is timestamp && data.timestamp <= request.time &&
             (!('progress' in data) || (data.progress is int && data.progress >= 0 && data.progress <= 100)) &&
             (!('recordTypes' in data) || (data.recordTypes is list && data.recordTypes.size() <= 10)) &&
             (!('downloadFormat' in data) || (data.downloadFormat in ['PDF', 'IMAGE']));
    }

    // --- Collection Rules ---

    // Users collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && 
                      incoming().keys().hasAll(['userId', 'email', 'createdAt', 'lastSignInAt']) &&
                      isValidUser(incoming());
      allow update: if isOwner(userId) &&
                      incoming().userId == existing().userId &&
                      incoming().createdAt == existing().createdAt &&
                      isValidUser(incoming()) &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl', 'lastSignInAt']);
      
      // Saved Records subcollection
      match /saved_records/{recordId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && 
                        isValidSavedRecord(incoming()) &&
                        isValidId(recordId);
        allow update: if isOwner(userId) &&
                        incoming().userId == existing().userId &&
                        incoming().downloadedAt == existing().downloadedAt &&
                        isValidSavedRecord(incoming()) &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['khatianCount', 'recordType', 'downloadFormat', 'fileSizeFormatted']);
        allow delete: if isOwner(userId);
      }

      // Download Tasks subcollection
      match /download_tasks/{taskId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && 
                        isValidDownloadTask(incoming()) &&
                        isValidId(taskId);
        allow update: if isOwner(userId) &&
                        incoming().userId == existing().userId &&
                        incoming().timestamp == existing().timestamp &&
                        isValidDownloadTask(incoming()) &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'progress', 'downloadedKhatians', 'speedKbps']);
        allow delete: if isOwner(userId);
      }
    }
  }
}
